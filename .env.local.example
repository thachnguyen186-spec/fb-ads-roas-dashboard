# Supabase — find these in your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Adjust API Revenue Fetch (optional) — enables "Fetch Data from Adjust API" on dashboard
# ADJUST_API_TOKEN: Bearer token from Adjust's Reports API (required if using API fetch)
# ADJUST_ACCOUNT_ID: Adjust account ID (required if using API fetch — needed because Adjust login may have multi-account access)
# ADJUST_APP_TOKEN: Comma-separated list of app tokens to restrict queries. If unset, auto-discovers all apps on the account.
ADJUST_API_TOKEN=
ADJUST_ACCOUNT_ID=
# ADJUST_APP_TOKEN=token1,token2,token3

# Spending Limit Monitor — Vercel Cron + Telegram alerts
# CRON_SECRET: random 32-char string, set in Vercel project env vars (matches vercel.json cron auth)
CRON_SECRET=replace-with-random-32-char-string
# TELEGRAM_BOT_TOKEN: from @BotFather; TELEGRAM_CHAT_ID: group chat ID (negative number for groups)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TikTok Ads (org-wide OAuth connection — tokens stored in DB, not here)
# TIKTOK_APP_ID: Developer App ID from TikTok for Business portal
# TIKTOK_APP_SECRET: Developer App secret (server-side only)
# TIKTOK_OAUTH_REDIRECT_URI: must exactly match the callback whitelisted in the portal
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=

# AFS Niche Testing
AFS_TOKEN_ENCRYPTION_KEY=   # base64 of 32 random bytes: openssl rand -base64 32
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna   # fallback gpt-5.4-nano if not enabled on the account
KIE_API_KEY=
KIE_MODEL=gpt-image/1.5-text-to-image   # [Validation Session 1] OpenAI's GPT-Image-1 hosted on Kie AI,
                                         # NOT google/nano-banana — user's explicit choice. Exact model id
                                         # string + input shape (quality vs resolution param) must be
                                         # confirmed against live docs.kie.ai before relying on this in
                                         # production — this value is a best-guess placeholder from a
                                         # WebSearch-only check, not a verified doc quote.
AFS_MAX_DAILY_BUDGET_MINOR=500000   # hard server-side ceiling ($5,000/day-equiv); rejects above this regardless of UI confirm
